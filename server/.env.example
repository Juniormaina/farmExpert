# Copy to .env and fill in real values. Never commit .env.

PORT=4000
SHAMBAAI_DB_PATH=./data/shambaai.db

# Local Ollama (optional, provider priority: hosted > ollama > deterministic)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Hosted provider. Use exactly one API_STYLE for a given vendor.
#   anthropic  -> x-api-key header, expects { content: [{ text }] }
#   openai     -> Authorization: Bearer, expects { choices: [{ message: { content } }] }
# Total time (ms) the server waits for AI phrasing before sending the template
# reply, which has the same numbers. Keep it under the web client's 15s limit.
AI_REPLY_BUDGET_MS=10000

API_STYLE=openai
HOSTED_AI_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
HOSTED_AI_MODEL=nvidia/nemotron-3-super-120b-a12b
HOSTED_AI_API_KEY=

# Verified to preserve prices/units exactly and reply in Kiswahili.
# Rejected: meta/llama-3.2-11b-vision-instruct (rewrites "acre" as "heka" = hectare)
# Rejected: openai/gpt-oss-20b (reasoning model, returns null content)
# Note: not every model in the /v1/models catalog is enabled for your account;
# unlisted access returns 404 "Function not found for account".
