# Farm Expert environment
#
# Copy this file to .env in the repository root:
#   cp .env.example .env
#
# The server reads this file first, then server/.env if that file exists.
# server/.env overrides the root file. Never commit either .env.
#
# VITE_SUPPORT_CONTACT is not read from this file. Put it in client/.env.
# See client/.env.example. Any VITE_ name is copied into the website and
# can be read by anyone who opens the page. Do not put an API key there.
#
# Classes used below:
#   required          the process needs it for the way you are running
#   optional          a default exists
#   development only  do not set this on the pilot host
#   pilot only        set this for the controlled farmer pilot

# --- Process ---------------------------------------------------------------

# optional. Default 4000.
PORT=4000

# required on the pilot host. Local development can leave this unset.
# NODE_ENV=production

# --- Database --------------------------------------------------------------

# optional locally. Pilot: required, and it must be the Render disk path.
# Production refuses to start when the path is under the OS temp directory
# unless ALLOW_EPHEMERAL_DB=1.
# Accepted fallbacks, in order: SMARTSHAMBAAI_DB_PATH, SHAMBAAI_DB_PATH, DATABASE_PATH.
FARMEXPERT_DB_PATH=./data/farmexpert.db

# development only. Do not set this for the pilot.
# ALLOW_EPHEMERAL_DB=1

# optional. Used by scripts/sqlite-backup.mjs. Default is ./backups.
# FARMEXPERT_BACKUP_DIR=./backups

# --- Web app ---------------------------------------------------------------

# required when one process serves the built site and the API (npm start, Render).
# SERVE_CLIENT=1

# optional. Default is client/dist, resolved from the repository.
# CLIENT_DIST_PATH=./client/dist

# optional. Comma-separated browser origins. Leave empty when the site and
# the API are the same host.
# CORS_ORIGIN=https://your-host.example

# --- Pilot build gate ------------------------------------------------------

# pilot only. When this is 1, scripts/check-pilot-env.mjs fails the build if
# the support contact is missing, the database path is under /tmp, or a
# hosted-AI, SMS, or USSD secret is set. Local npm run build does not set it.
# PILOT_REQUIRE_SUPPORT=1

# --- Support ---------------------------------------------------------------

# pilot only, and client-visible. Set the real route in client/.env, not here.
# Leave client/.env empty until a person gives you that route. Do not invent one.
# VITE_SUPPORT_CONTACT=

# --- Demo reset ------------------------------------------------------------

# optional. Production secret for POST /api/demo/reset, sent as x-farmexpert-token.
# Leave unset so the route stays closed. Development does not need it.
# Never give this value to farmers.
# DEMO_RESET_TOKEN=

# --- Hosted model ----------------------------------------------------------

# development only for the current pilot. Leave the key empty.
# The deterministic agent answers when no key is set.
# A model may only rephrase a reply. The server drops a rephrase that changes
# a number or adds a claim the template did not allow.
#
# API_STYLE=openai uses Authorization: Bearer and choices[0].message.content.
# API_STYLE=anthropic uses x-api-key and content[0].text.
# AI_REPLY_BUDGET_MS is how long to wait before sending the template reply.
# Keep it under the web client's 15 second limit.

# API_STYLE=openai
# AI_REPLY_BUDGET_MS=10000
# HOSTED_AI_BASE_URL=
# HOSTED_AI_MODEL=
# HOSTED_AI_API_KEY=
# HOSTED_AI_TIMEOUT_MS=30000
# HOSTED_AI_MAX_TOKENS=3000

# Optional aliases for the same hosted provider. A pilot build rejects either key.
# MODELSCOPE_API_KEY=
# MODELSCOPE_BASE_URL=
# MODELSCOPE_MODEL=

# --- Local model -----------------------------------------------------------

# optional. Used only when no hosted key is set and Ollama is running.
# OLLAMA_BASE_URL is an alias for OLLAMA_HOST. Leave unset on the pilot host.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# --- Phone gateways --------------------------------------------------------

# development only for the current pilot. Leave both unset.
# A real SMS or USSD provider would send this value as x-farmexpert-token.
# Without it, POST /api/providers/sms and POST /api/providers/ussd return 503.
# The web pilot does not need a farmer's phone number.
# SMS_WEBHOOK_TOKEN=
# USSD_WEBHOOK_TOKEN=
